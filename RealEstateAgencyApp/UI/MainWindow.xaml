<Window x:Class="RealEstateAgencyApp.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ИС Риэлтерского агентства" Height="860" Width="1400"
        MinHeight="760" MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9">
    <Window.Resources>
        <!-- Theme -->
        <Color x:Key="C_Bg">#F6F8FC</Color>
        <Color x:Key="C_Card">#FFFFFFFF</Color>
        <Color x:Key="C_Text">#0F172A</Color>
        <Color x:Key="C_Muted">#64748B</Color>
        <Color x:Key="C_Border">#D9E2F0</Color>
        <Color x:Key="C_Accent">#3B82F6</Color>
        <Color x:Key="C_Accent2">#6366F1</Color>
        <Color x:Key="C_Danger">#EF4444</Color>

        <SolidColorBrush x:Key="BgBrush" Color="{StaticResource C_Bg}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource C_Card}"/>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource C_Text}"/>
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource C_Muted}"/>
        <SolidColorBrush x:Key="BorderBrushSoft" Color="{StaticResource C_Border}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource C_Accent}"/>
        <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource C_Accent2}"/>
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource C_Danger}"/>

        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource C_Accent}" Offset="0"/>
            <GradientStop Color="{StaticResource C_Accent2}" Offset="1"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow" Color="#0B1220" BlurRadius="22" ShadowDepth="6" Opacity="0.14"/>

        <!-- Tabs -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Grid>
                            <Border x:Name="Bd"
                                    Background="Transparent"
                                    CornerRadius="10"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                            <Border x:Name="Underline" Height="3" CornerRadius="2"
                                    Background="{StaticResource AccentBrush}"
                                    VerticalAlignment="Bottom"
                                    Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D3B82F6"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#123B82F6"/>
                                <Setter TargetName="Underline" Property="Opacity" Value="1"/>
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid -->
        <Style TargetType="DataGrid">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="HeadersVisibility" Value="All"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="40"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EEF8"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E7EEF8"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FAFF"/>
            <Setter Property="RowBackground" Value="{StaticResource CardBrush}"/>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#143B82F6"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#203B82F6"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F6FF"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <!-- Inputs -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderBrush" Value="#C7D2E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FCFDFF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="BorderBrush" Value="#C7D2E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FCFDFF"/>
        </Style>

        <Style TargetType="DatePicker">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="MinHeight" Value="34"/>
        </Style>

        <!-- Cards -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Background="#0D3B82F6" CornerRadius="10" Padding="10,6" Margin="0,0,0,12">
                                    <ContentPresenter ContentSource="Header" />
                                </Border>
                                <ContentPresenter Grid.Row="1" />
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Background" Value="{StaticResource AccentGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#00000000"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#0B1220" BlurRadius="14" ShadowDepth="4" Opacity="0.18"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.84"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="ActionButtonSecondaryStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="#EAF2FF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>

        <Style x:Key="ActionButtonDangerStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,2,0,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Padding="18"
                Margin="0,0,0,14"
                Background="{StaticResource AccentGradient}">
            <Border.Effect>
                <DropShadowEffect Color="#0B1220" BlurRadius="26" ShadowDepth="8" Opacity="0.18"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="White">ИС риэлтерского агентства</TextBlock>
                <TextBlock Grid.Row="1" Margin="0,4,0,0" Foreground="#EAF2FF" FontSize="13">
                    Клиенты • Объекты • Сделки • Отчёты
                </TextBlock>
            </Grid>
        </Border>

        <TabControl Grid.Row="1">
            <TabItem Header="Клиенты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DgClients" Grid.Row="0" IsReadOnly="True"/>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Карта клиента</TextBlock>
                                    <TextBlock Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}">Заполните поля и выберите действие справа</TextBlock>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="0,2,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">ID клиента (для изменения/удаления)</TextBlock>
                                            <TextBox x:Name="TbClientId" ToolTip="ID (для изменения/удаления)"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Тип клиента</TextBlock>
                                            <ComboBox x:Name="CbClientType" ToolTip="Тип клиента"
                                                      SelectionChanged="ComboPersistClient_OnSelectionChanged">
                                                <ComboBoxItem Content="Покупатель"/>
                                                <ComboBoxItem Content="Арендатор"/>
                                                <ComboBoxItem Content="Продавец"/>
                                                <ComboBoxItem Content="Арендодатель"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">ФИО</TextBlock>
                                            <TextBox x:Name="TbClientName" ToolTip="ФИО"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Телефон</TextBlock>
                                            <TextBox x:Name="TbClientPhone" ToolTip="Телефон"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Email</TextBlock>
                                            <TextBox x:Name="TbClientEmail" ToolTip="Email"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1"
                                Width="190"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Действия</TextBlock>
                                <Button Style="{StaticResource ActionButtonStyle}" Click="BtnClientAdd_OnClick">Добавить</Button>
                                <Button Style="{StaticResource ActionButtonSecondaryStyle}" Click="BtnClientUpdate_OnClick">Изменить</Button>
                                <Button Style="{StaticResource ActionButtonDangerStyle}" Click="BtnClientDelete_OnClick">Удалить</Button>
                                <Border Height="1" Margin="0,4,0,10" Background="#E7EEF8"/>
                                <Button Style="{StaticResource ActionButtonSecondaryStyle}" Margin="0" Click="BtnClientsRefresh_OnClick">Обновить</Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Объекты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DgProperties" Grid.Row="0" IsReadOnly="True"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,8">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">Тип</TextBlock>
                            <TextBox x:Name="TbSearchType" Width="140" ToolTip="Тип"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">Мин. цена</TextBlock>
                            <TextBox x:Name="TbSearchMinPrice" Width="120" ToolTip="Мин. цена"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">Макс. цена</TextBlock>
                            <TextBox x:Name="TbSearchMaxPrice" Width="120" ToolTip="Макс. цена"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">Комнат</TextBlock>
                            <TextBox x:Name="TbSearchRooms" Width="100" ToolTip="Комнат"/>
                        </StackPanel>
                        <Button Width="140" Margin="0,0,6,0" Click="BtnPropertySearch_OnClick">Поиск</Button>
                        <Button Width="190" Click="BtnPropertyShowActive_OnClick">Только активные</Button>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Карта объекта</TextBlock>
                                    <TextBlock Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}">Параметры недвижимости</TextBlock>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="0,2,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">ID объекта</TextBlock>
                                            <TextBox x:Name="TbPropertyId" ToolTip="ID (для изменения/удаления)"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Тип объекта</TextBlock>
                                            <ComboBox x:Name="CbPropertyType" ToolTip="Тип объекта"
                                                      SelectionChanged="ComboPersistProperty_OnSelectionChanged">
                                                <ComboBoxItem Content="Квартира"/>
                                                <ComboBoxItem Content="Дом"/>
                                                <ComboBoxItem Content="Комната"/>
                                                <ComboBoxItem Content="Коммерческая недвижимость"/>
                                                <ComboBoxItem Content="Земельный участок"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Адрес</TextBlock>
                                            <TextBox x:Name="TbPropertyAddress" ToolTip="Адрес"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Площадь</TextBlock>
                                            <TextBox x:Name="TbPropertyArea" ToolTip="Площадь"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="2" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Комнат</TextBlock>
                                            <TextBox x:Name="TbPropertyRooms" ToolTip="Количество комнат"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Этаж</TextBlock>
                                            <TextBox x:Name="TbPropertyFloor" ToolTip="Этаж"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Цена</TextBlock>
                                            <TextBox x:Name="TbPropertyPrice" ToolTip="Цена"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Статус</TextBlock>
                                            <ComboBox x:Name="CbPropertyStatus" ToolTip="Статус"
                                                      SelectionChanged="ComboPersistProperty_OnSelectionChanged">
                                                <ComboBoxItem Content="Активно"/>
                                                <ComboBoxItem Content="Забронирован"/>
                                                <ComboBoxItem Content="Продан"/>
                                                <ComboBoxItem Content="Арендовано"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Grid.Row="4" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">ID владельца</TextBlock>
                                            <TextBox x:Name="TbPropertyOwnerId" ToolTip="ID владельца"/>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Width="190"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Действия</TextBlock>
                                <Button Style="{StaticResource ActionButtonStyle}" Click="BtnPropertyAdd_OnClick">Добавить</Button>
                                <Button Style="{StaticResource ActionButtonSecondaryStyle}" Click="BtnPropertyUpdate_OnClick">Изменить</Button>
                                <Button Style="{StaticResource ActionButtonDangerStyle}" Click="BtnPropertyDelete_OnClick">Удалить</Button>
                                <Border Height="1" Margin="0,4,0,10" Background="#E7EEF8"/>
                                <Button Style="{StaticResource ActionButtonSecondaryStyle}" Margin="0" Click="BtnPropertiesRefresh_OnClick">Обновить</Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Сделки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3*"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="DgDeals" Grid.Row="0" IsReadOnly="True"/>
                    <Grid Grid.Row="1" Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14"
                                Effect="{StaticResource CardShadow}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Карта сделки</TextBlock>
                                    <TextBlock Margin="10,0,0,0" Foreground="{StaticResource MutedBrush}">Выбор объекта, клиента и параметров</TextBlock>
                                </StackPanel>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <Grid Margin="0,2,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">ID сделки</TextBlock>
                                            <TextBox x:Name="TbDealId" ToolTip="ID (для изменения/удаления)"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="0" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Тип сделки</TextBlock>
                                            <ComboBox x:Name="CbDealType" ToolTip="Тип сделки"
                                                      SelectionChanged="ComboPersistDeal_OnSelectionChanged">
                                                <ComboBoxItem Content="Продажа"/>
                                                <ComboBoxItem Content="Аренда"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Объект</TextBlock>
                                            <ComboBox x:Name="CbDealProperty" IsEditable="False" ToolTip="Выберите объект недвижимости"
                                                      SelectionChanged="ComboPersistDeal_OnSelectionChanged">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock>
                                                            <TextBlock.Text>
                                                                <MultiBinding StringFormat="#{0} — {1}">
                                                                    <Binding Path="PropertyID"/>
                                                                    <Binding Path="Address"/>
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Клиент</TextBlock>
                                            <ComboBox x:Name="CbDealClient" IsEditable="False" DisplayMemberPath="FullName" ToolTip="Выберите клиента"
                                                      SelectionChanged="ComboPersistDeal_OnSelectionChanged"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Сумма</TextBlock>
                                            <TextBox x:Name="TbDealAmount" ToolTip="Сумма"/>
                                        </StackPanel>
                                        <StackPanel Grid.Row="3" Grid.Column="1">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Дата</TextBlock>
                                            <DatePicker x:Name="DpDealDate"/>
                                        </StackPanel>

                                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2">
                                            <TextBlock Style="{StaticResource FieldLabelStyle}">Статус</TextBlock>
                                            <ComboBox x:Name="CbDealStatus" ToolTip="Статус"
                                                      SelectionChanged="ComboPersistDeal_OnSelectionChanged">
                                                <ComboBoxItem Content="Черновик"/>
                                                <ComboBoxItem Content="Завершена"/>
                                                <ComboBoxItem Content="Отменена"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                </ScrollViewer>
                            </Grid>
                        </Border>

                        <Border Grid.Column="1"
                                Width="190"
                                Margin="12,0,0,0"
                                VerticalAlignment="Top"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource BorderBrushSoft}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12"
                                Effect="{StaticResource CardShadow}">
                            <StackPanel>
                                <TextBlock Margin="0,0,0,10" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Действия</TextBlock>
                                <Button Style="{StaticResource ActionButtonStyle}" Click="BtnDealAdd_OnClick">Добавить</Button>
                                <Button Style="{StaticResource ActionButtonSecondaryStyle}" Click="BtnDealUpdate_OnClick">Изменить</Button>
                                <Button Style="{StaticResource ActionButtonDangerStyle}" Click="BtnDealDelete_OnClick">Удалить</Button>
                                <Border Height="1" Margin="0,4,0,10" Background="#E7EEF8"/>
                                <Button Style="{StaticResource ActionButtonSecondaryStyle}" Margin="0" Click="BtnDealsRefresh_OnClick">Обновить</Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Оформление сделки">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,6" FontWeight="SemiBold">Активный объект:</TextBlock>
                    <ComboBox x:Name="CbActiveProperties" Grid.Row="1" Margin="0,0,0,10" DisplayMemberPath="Address"/>

                    <TextBlock Grid.Row="2" Margin="0,0,0,6" FontWeight="SemiBold">Клиент:</TextBlock>
                    <ComboBox x:Name="CbClientsForDeal" Grid.Row="3" Margin="0,0,0,10" DisplayMemberPath="FullName"/>

                    <StackPanel Grid.Row="4" Orientation="Horizontal">
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">Тип сделки</TextBlock>
                            <ComboBox x:Name="CbDealTypeComplete" Width="180">
                                <ComboBoxItem Content="Продажа"/>
                                <ComboBoxItem Content="Аренда"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Style="{StaticResource FieldLabelStyle}">Сумма</TextBlock>
                            <TextBox x:Name="TbDealCompleteAmount" Width="180" ToolTip="Сумма"/>
                        </StackPanel>
                        <Button Width="220" Click="BtnCompleteDeal_OnClick">Оформить и завершить</Button>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Отчеты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <DatePicker x:Name="DpStartDate" Width="150" Margin="0,0,8,0"/>
                        <DatePicker x:Name="DpEndDate" Width="150" Margin="0,0,8,0"/>
                        <Button Width="220" Click="BtnReportPeriod_OnClick">Отчет по сделкам за период</Button>
                    </StackPanel>
                    <ListBox x:Name="LbPeriodReport" Grid.Row="1"/>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,8">
                        <ComboBox x:Name="CbClientReport" Width="350" Margin="0,0,8,0" DisplayMemberPath="FullName"/>
                        <Button Width="180" Click="BtnReportClient_OnClick">Отчет по клиенту</Button>
                    </StackPanel>
                    <ListBox x:Name="LbClientReport" Grid.Row="3"/>
                </Grid>
            </TabItem>

            <TabItem Header="Все таблицы БД">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="12"
                            Margin="0,0,0,12"
                            Effect="{StaticResource CardShadow}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}">Таблица</TextBlock>
                            <ComboBox Grid.Column="1" x:Name="CbAllTables" MinWidth="360" SelectionChanged="CbAllTables_OnSelectionChanged"/>
                            <Button Grid.Column="2" Style="{StaticResource ActionButtonSecondaryStyle}" Margin="12,0,0,0" Click="BtnRefreshAllTables_OnClick">Обновить список</Button>
                        </Grid>
                    </Border>

                    <DataGrid x:Name="DgAllTablesData" Grid.Row="1" IsReadOnly="True"/>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
